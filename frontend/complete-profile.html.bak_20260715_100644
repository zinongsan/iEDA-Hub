<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>完善个人信息 - iEDA-Hub v2</title>
<link rel="icon" type="image/svg+xml" href="/frontend/iedahub_navy_flat.svg">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
    background: linear-gradient(135deg, #0f2c5e 0%, #1e3c72 50%, #2a5298 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow-x: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
                 "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
}
body::after {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
        radial-gradient(circle at 20% 80%, rgba(255,255,255,0.06) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(255,255,255,0.05) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
}

.auth-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 620px;
    padding: 40px 28px;
    position: relative;
    z-index: 1;
}

/* 品牌头部 */
.brand { text-align: center; margin-bottom: 40px; }
.brand-logo {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin-bottom: 24px !important;
    width: 120px !important;
    height: 120px !important;
    border-radius: 26px !important;
    overflow: hidden !important;
    background: rgba(255,255,255,.14) !important;
    box-shadow: 0 12px 40px rgba(0,0,0,.28), inset 0 0 0 1px rgba(255,255,255,.22) !important;
    backdrop-filter: blur(8px) !important;
    transition: transform .4s cubic-bezier(.2,.9,.3,1.1) !important;
}
.brand-logo:hover { transform: translateY(-4px) scale(1.03); }
.brand-logo img {
    height: 120px !important;
    width: 120px !important;
    filter: none !important;
    background: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
}
.brand-title {
    font-size: 46px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #fff;
    text-shadow: 0 4px 24px rgba(0,0,0,.28);
    line-height: 1.3;
    margin-bottom: 12px;
}
.brand-subtitle {
    font-size: 17px;
    color: rgba(255,255,255,.8);
    letter-spacing: 2px;
    font-weight: 400;
}

/* 卡片 */
.card {
    position: relative;
    z-index: 1;
    background: #fff;
    border-radius: 24px;
    box-shadow: 0 28px 70px rgba(0,0,0,.30), 0 0 0 1px rgba(255,255,255,.18) inset;
    padding: 52px 56px 44px;
    width: 100%;
    animation: cardIn .55s cubic-bezier(.2,.9,.3,1.05);
}
@keyframes cardIn {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
}
.card h1 {
    text-align: center;
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 12px;
    background: linear-gradient(135deg, #024BA1, #1a6fcf);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}
.card .tip {
    text-align: center;
    color: #6B7280;
    font-size: 14px;
    margin-bottom: 28px;
}

/* 消息 */
.msg {
    padding: 14px 18px;
    border-radius: 12px;
    margin-bottom: 20px;
    font-size: 14px;
    display: none;
    border-left: 4px solid;
}
.msg.error {
    background: #FEF2F2;
    color: #B91C1C;
    border-color: #EF4444;
    display: block;
}
.msg.success {
    background: #ECFDF5;
    color: #047857;
    border-color: #10B981;
    display: block;
}

/* 表单 */
.field { margin-bottom: 24px; position: relative; }
.field label {
    display: block;
    font-size: 15px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 10px;
}
.field label .required {
    color: #EF4444;
    margin-left: 2px;
}
.field input, .field select {
    width: 100%;
    padding: 16px 20px;
    border: 2px solid #E5E7EB;
    border-radius: 14px;
    font-size: 17px;
    background: #F9FAFB;
    transition: all .22s ease;
    color: #111827;
}
.field input:focus, .field select:focus {
    outline: none;
    border-color: #024BA1;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(2,75,161,0.12);
}
.field input::placeholder {
    color: #9CA3AF;
}
.field input.error {
    border-color: #EF4444;
}
.field-error {
    display: none;
    color: #EF4444;
    font-size: 13px;
    margin-top: 6px;
}

/* 角色选择 */
.role-select {
    display: flex;
    gap: 16px;
}
.role-select label {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    border: 2px solid #E5E7EB;
    border-radius: 14px;
    cursor: pointer;
    transition: all .22s ease;
    font-weight: 500;
    color: #6B7280;
}
.role-select label:hover {
    border-color: #024BA1;
    background: #F0F7FF;
}
.role-select input[type="radio"] {
    margin-right: 8px;
    width: auto;
}
.role-select input[type="radio"]:checked + span {
    color: #024BA1;
}
.role-select label:has(input:checked) {
    border-color: #024BA1;
    background: #F0F7FF;
    color: #024BA1;
}

/* 按钮 */
.actions {
    display: flex;
    gap: 12px;
    margin-top: 32px;
}
.btn {
    flex: 1;
    padding: 16px;
    border: none;
    border-radius: 14px;
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    transition: all .25s ease;
    letter-spacing: 1px;
}
.btn-primary {
    background: linear-gradient(135deg, #024BA1, #1a6fcf);
    color: #fff;
    box-shadow: 0 6px 20px rgba(2,75,161,0.35);
}
.btn-primary:hover:not(:disabled) {
    background: linear-gradient(135deg, #013A7E, #0f50b3);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(2,75,161,0.45);
}
.btn-secondary {
    background: #F3F4F6;
    color: #6B7280;
    border: 2px solid #E5E7EB;
}
.btn-secondary:hover:not(:disabled) {
    background: #E5E7EB;
    color: #374151;
}
.btn:disabled {
    background: #9CA3AF;
    cursor: not-allowed;
    opacity: 0.6;
}

/* 响应式 */
@media(max-width:480px){
    .auth-wrapper { padding: 28px 18px; }
    .card { padding: 34px 26px; }
    .brand-title { font-size: 32px; }
    .brand-subtitle { font-size: 14px; }
    .brand-logo { width: 96px !important; height: 96px !important; }
    .brand-logo img { height: 96px !important; width: 96px !important; }
}
</style>
</head>
<body>
<div class="auth-wrapper">
    <div class="brand">
        <div class="brand-logo">
            <img src="/frontend/iedahub_navy_flat.svg" alt="iEDA-Hub" onerror="this.style.display='none'">
        </div>
        <div class="brand-title">iEDA-Hub</div>
        <div class="brand-subtitle">National Center of Technology Innovation for EDA</div>
    </div>

    <div class="card">
        <h1>完善个人信息</h1>
        <p class="tip">完善信息解锁更多功能</p>

        <div class="msg" id="msg"></div>

        <form id="form">
            <div class="field">
                <label>真实姓名 <span class="required">*</span></label>
                <input type="text" name="real_name" placeholder="请输入真实姓名" required>
                <div class="field-error"></div>
            </div>

            <div class="field">
                <label>我是 <span class="required">*</span></label>
                <div class="role-select">
                    <label>
                        <input type="radio" name="role" value="student" required>
                        <span>学生</span>
                    </label>
                    <label>
                        <input type="radio" name="role" value="teacher" required>
                        <span>老师</span>
                    </label>
                </div>
                <div class="field-error"></div>
            </div>

            <!-- 学生字段（条件显示）-->
            <div id="studentFields" style="display:none">
                <div class="field">
                    <label>学号 <span class="required">*</span></label>
                    <input type="text" name="student_id" placeholder="请输入学号" id="studentIdInput">
                    <div class="field-error"></div>
                </div>
                <div class="field">
                    <label>专业 <span class="required">*</span></label>
                    <input type="text" name="major" placeholder="请输入专业" id="majorInput">
                    <div class="field-error"></div>
                </div>
            </div>

            <!-- 学校 -->
            <div class="field">
                <label>学校 <span class="required">*</span></label>
                <input type="text" name="school" placeholder="请输入学校名称" required>
            </div>

            <!-- 老师字段（条件显示）-->
            <div id="teacherFields" style="display:none">
                <div class="field">
                    <label>学院 <span class="required">*</span></label>
                    <input type="text" name="college" placeholder="请输入学院" id="collegeInput">
                    <div class="field-error"></div>
                </div>
            </div>

            <div class="field">
                <label>手机号</label>
                <input type="tel" name="phone" placeholder="请输入手机号" pattern="^1[3-9]\d{9}$">
                <div class="field-error"></div>
            </div>

            <div class="actions">
                <button type="button" class="btn btn-secondary" id="skipBtn">稍后完善</button>
                <button type="submit" class="btn btn-primary" id="submitBtn">提交</button>
            </div>
        </form>
    </div>
</div>

<script>
// API调用函数（内联版本）
async function api(url, options = {}) {
    try {
        const response = await fetch(url, {
            headers: {
                'Content-Type': 'application/json',
                ...options.headers
            },
            credentials: 'include',
            ...options
        });

        if (!response.ok) {
            const error = await response.json().catch(() => ({}));
            throw new Error(error.detail || error.message || `请求失败: ${response.status}`);
        }

        const contentType = response.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
            return await response.json();
        }
        return null;
    } catch (error) {
        if (error.message) throw error;
        throw new Error('网络请求失败');
    }
}

const form = document.getElementById('form');
const msg = document.getElementById('msg');
const submitBtn = document.getElementById('submitBtn');
const skipBtn = document.getElementById('skipBtn');
const studentFields = document.getElementById('studentFields');
const teacherFields = document.getElementById('teacherFields');
const studentIdInput = document.getElementById('studentIdInput');
const majorInput = document.getElementById('majorInput');
const collegeInput = document.getElementById('collegeInput');

// 根据角色切换显示字段
document.querySelectorAll('input[name="role"]').forEach(radio => {
    radio.addEventListener('change', (e) => {
        const role = e.target.value;
        if (role === 'student') {
            studentFields.style.display = 'block';
            teacherFields.style.display = 'none';
            studentIdInput.required = true;
            majorInput.required = true;
            collegeInput.required = false;
        } else if (role === 'teacher') {
            studentFields.style.display = 'none';
            teacherFields.style.display = 'block';
            studentIdInput.required = false;
            majorInput.required = false;
            collegeInput.required = true;
        }
    });
});

// 提交表单
form.onsubmit = async (e) => {
    e.preventDefault();
    msg.className = 'msg';
    submitBtn.disabled = true;
    submitBtn.textContent = '提交中...';

    const formData = new FormData(form);
    const data = {
        real_name: formData.get('real_name').trim(),
        role: formData.get('role'),
        student_id: formData.get('student_id')?.trim() || null,
        school: formData.get('school').trim(),
        major: formData.get('major')?.trim() || null,
        college: formData.get('college')?.trim() || null,
        phone: formData.get('phone')?.trim() || null
    };

    try {
        await api('/api/v1/users/me/complete-profile', {
            method: 'POST',
            body: JSON.stringify(data)
        });

        msg.className = 'msg success';
        msg.textContent = '信息完善成功！';
        setTimeout(() => location.href = '/app/iedahub', 1000);
    } catch (err) {
        msg.className = 'msg error';
        msg.textContent = err.message || '提交失败，请重试';
        submitBtn.disabled = false;
        submitBtn.textContent = '提交';
    }
};

// 稍后完善
skipBtn.onclick = () => {
    location.href = '/app/iedahub';
};
</script>
</body>
</html>
