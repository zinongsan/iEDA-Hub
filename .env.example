# ============================================
# 国创 Web 平台 – 环境变量模板
# 用法：cp .env.example .env  然后按注释修改
# ============================================

# ---- 应用 ----
APP_NAME=国创平台
# development: 本地/测试（弱密钥仅告警，cookie 不带 Secure）
# production : 生产（弱密钥拒启，cookie 带 Secure，下发 HSTS）
APP_ENV=development
DEBUG=false

# 【必改】JWT 签名密钥。生成强随机串：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# 注意：APP_ENV=production 时使用下方默认弱密钥会拒绝启动。
SECRET_KEY=dev-secret-key-please-override

# ---- 数据库 (PostgreSQL) ----
# docker compose 内服务名是 db；本机直连请改成 localhost
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/guochuang
# 以下三项供 docker-compose.yml 的 db 服务首次建库使用（仅首次生效）；
# 若修改 POSTGRES_PASSWORD，务必同步修改上方 DATABASE_URL 中的密码。
POSTGRES_DB=guochuang
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- JWT 有效期 ----
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 管理员初始账号 ----
# 首次启动时 src/main.py 的 _init_data 会据此创建管理员；
# backend/create_admin.py 也读取同一变量，二者一致，避免“两套密码”。
# 注意：_init_data 用 ON CONFLICT DO NOTHING，只新建不更新——
# 改密码后需重跑 create_admin.py 才会覆盖已有管理员。
ADMIN_EMAIL=admin@guochuang.com
# 【必改】生产环境请改成强密码
ADMIN_PASSWORD=change-this-admin-password

# ---- 限流 (slowapi，基于 Redis) ----
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute

# ---- 受信反代 IP（逗号分隔）----
# 仅当请求“直连对端”在此列表时才信任 X-Forwarded-For。
# uvicorn 直接对外（无反代）请留空，限流按真实连接 IP 计，防止伪造 XFF 绕过。
TRUSTED_PROXIES=

# ---- CORS 允许来源（逗号分隔）----
ALLOWED_ORIGINS=http://localhost:8080

# ---- 邮件 (SMTP，用于邮箱验证 / 忘记密码发信) ----
# 飞书公共邮箱示例：仅用 SMTP 发信，IMAP 用不到。
# SMTP_USER 为邮箱地址，SMTP_PASSWORD 为邮箱后台生成的 SMTP 授权码（非登录密码）。
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=465
SMTP_USER=iedahub@example.com
SMTP_PASSWORD=replace-with-smtp-auth-code
SMTP_FROM=iedahub@example.com
SMTP_USE_SSL=true

# 邮件内链接的基础地址（用户从邮件点击链接跳转到这里，须为用户可访问的绝对地址）
APP_BASE_URL=http://localhost:8080

# 邮箱验证策略：true=未验证邮箱禁止登录；false=可登录但页面提示未验证并提供重发
EMAIL_VERIFICATION_REQUIRED=false
# 验证链接有效期（分钟）
VERIFY_TOKEN_TTL_MINUTES=1440
# 重置密码链接有效期（分钟）
RESET_TOKEN_TTL_MINUTES=15
